{
  "name": "anime-draft",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build && node scripts/restore-vercel-module-mode.cjs",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "test:draft-turns": "node --experimental-strip-types --test tests/draftTurns.test.mjs",
    "test:activity": "node --experimental-strip-types --test tests/draftActivity.test.mjs",
    "test:awards": "node --experimental-strip-types --test tests/draftAwards.test.mjs",
    "test:ballot": "node --experimental-strip-types --test tests/ballotInteraction.test.mjs",
    "test:categories": "node --experimental-strip-types --test tests/draftCategories.test.mjs",
    "test:identity": "node --experimental-strip-types --test tests/lobbyIdentity.test.mjs",
    "test:invite": "node --experimental-strip-types --test tests/lobbyInvite.test.mjs",
    "test:lobby-players": "node --experimental-strip-types --test tests/lobbyPlayers.test.mjs",
    "test:progress": "node --experimental-strip-types --test tests/draftProgress.test.mjs",
    "test:preflight": "node --experimental-strip-types --test tests/draftPreflight.test.mjs",
    "test:order": "node --experimental-strip-types --test tests/draftOrder.test.mjs",
    "test:pick-availability": "node --experimental-strip-types --test tests/draftPickAvailability.test.mjs",
    "test:recap-share": "node --experimental-strip-types --test tests/draftRecapShare.test.mjs",
    "test:readiness": "node --experimental-strip-types --test tests/draftReadiness.test.mjs",
    "test:room-discovery": "node --experimental-strip-types --test tests/draftRoomDiscovery.test.mjs",
    "test:shortlist": "node --experimental-strip-types --test tests/draftShortlist.test.mjs",
    "test:turn-alerts": "node --experimental-strip-types --test tests/draftTurnAlerts.test.mjs",
    "test:undo": "node --experimental-strip-types --test tests/draftUndo.test.mjs",
    "test:voting": "node --experimental-strip-types --test tests/votesLogic.test.mjs",
    "test:blind-ranking": "node --experimental-strip-types --test tests/blindRanking.test.mjs",
    "test:custom-ranking": "node --experimental-strip-types --test tests/customRanking.test.mjs",
    "test:api-response": "node --experimental-strip-types --test tests/apiResponse.test.mjs",
    "test:shelf": "node --experimental-strip-types --test tests/shelfScore.test.mjs tests/shelfFranchise.test.mjs tests/shelfBuild.test.mjs tests/shelfCharacters.test.mjs tests/shelfMatch.test.mjs",
    "shelf:catalog": "node --experimental-strip-types scripts/shelf-catalog.ts",
    "shelf:solaris": "node --experimental-strip-types scripts/shelf-solaris.ts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@vercel/kv": "^1.0.1",
    "dotenv": "^17.2.3",
    "drizzle-orm": "0.45.2",
    "html-to-image": "^1.11.11",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  }
}
